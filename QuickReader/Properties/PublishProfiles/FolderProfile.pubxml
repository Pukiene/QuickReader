<?xml version="1.0" encoding="utf-8"?>
<!-- Right-click the project > Publish > FolderProfile. Makes one QuickReader.exe in bin\publish. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Use win-arm64 on an ARM (Snapdragon) PC. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Uses the .NET 10 Desktop Runtime already on the PC, so the .exe stays small. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Pre-compiled: starts faster and uses less memory. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
